# Copy to .env and fill in. Never commit .env.

# PostgreSQL (asyncpg driver). Schema is `rerouteher`.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rerouteher

# CORS: the Vite dev client origin(s), comma-separated.
CORS_ORIGINS=http://localhost:5173

# ML assets. EMBEDDING_MODEL points at the vendored model folder (loaded by path, no HF download).
EMBEDDING_MODEL=models/all-MiniLM-L6-v2
TFIDF_MODEL_PATH=ml/tfidf_logreg.joblib

# Tuning (team to finalise)
OCCUPATION_CONFIDENCE_THRESHOLD=0.65
# ESCO title-retrieval similarity is not classifier probability.
OCCUPATION_RETRIEVAL_THRESHOLD=0.75
# Direct MASCO role-vector similarity; low-scoring slots stay empty.
ROLE_COSINE_THRESHOLD=0.65
SKILL_COSINE_THRESHOLD=0.55
# Exact namespace of the existing approved D13 mapping metadata.
MAPPING_METADATA_PREFIX=d13_quality_fix_20260830.mapping.
# Shared parser/snapshot catalog refresh. Set 0 for immediate test refresh.
SKILL_CACHE_TTL_SECONDS=60

# ai_exposure -> 0-1 blend weight used by the readiness formula
AI_EXPOSURE_LOW=0.2
AI_EXPOSURE_MEDIUM=0.4
AI_EXPOSURE_HIGH=0.6

# CV upload limit
MAX_CV_BYTES=10485760
